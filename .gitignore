*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.mobileprovision
*.keychain
*.keychain-db
*.secrets.json
secrets/

# Local simulation state and diagnostics.
*.journal
*.journal.*
*.dump
*.dmp
core
core.*
*.crash
*.trace
*.nettrace
*.gcdump
*.speedscope.json
vmmap*.txt

# IDE/user-local state.
.idea/
.vscode/
*.user
*.suo
