# Third-party installers and extracted vendor payloads stay local.
analysis/vendor-installer/
*.exe

# macOS metadata.
.DS_Store

# Local SDK and .NET build output.
.tools/
**/bin/
**/obj/
artifacts/

# Local environment and diagnostic files must never enter version control.
.env
.env.*
*.log

