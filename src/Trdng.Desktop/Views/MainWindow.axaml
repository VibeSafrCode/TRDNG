<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trdng.Desktop.ViewModels"
        x:Class="Trdng.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="720" MinWidth="960" MinHeight="540"
        FontSize="14" Background="#0B0D10" Foreground="#F3F4F6"
        Title="{Binding InstrumentTitle, StringFormat='MMM_618 · {0}'}">
  <Window.Resources>
    <DataTemplate x:Key="AskRow" x:DataType="vm:BookLevelViewModel">
      <Grid Height="{Binding RowHeight}" Opacity="{Binding RowOpacity}">
        <Border Width="{Binding VisualWidth}" HorizontalAlignment="Right" Background="{Binding BarColor}" />
        <Grid Margin="10,0" ColumnDefinitions="12,Auto,*,Auto">
          <TextBlock Text="{Binding SignificanceMarker}" Foreground="#FF8A80" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="{Binding QuantityColor}" FontSize="{Binding TextSize}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Behavior}" Foreground="{Binding BehaviorColor}" FontSize="{Binding BehaviorTextSize}" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="{Binding Price}" Foreground="#FFD60A" FontSize="{Binding TextSize}" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BidRow" x:DataType="vm:BookLevelViewModel">
      <Grid Height="{Binding RowHeight}" Opacity="{Binding RowOpacity}">
        <Border Width="{Binding VisualWidth}" HorizontalAlignment="Left" Background="{Binding BarColor}" />
        <Grid Margin="10,0" ColumnDefinitions="12,Auto,*,Auto">
          <TextBlock Text="{Binding SignificanceMarker}" Foreground="#5DE47A" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="{Binding QuantityColor}" FontSize="{Binding TextSize}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Behavior}" Foreground="{Binding BehaviorColor}" FontSize="{Binding BehaviorTextSize}" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="{Binding Price}" Foreground="#64D2FF" FontSize="{Binding TextSize}" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BookSettingsPanel" x:DataType="vm:VenueBookSettingsViewModel">
      <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="286" Spacing="7" Margin="4">
          <TextBlock Text="{Binding SettingsTitle}" FontWeight="Bold" />
          <TextBlock Text="ГЛУБИНА" Foreground="#8B93A1" FontSize="10" />
          <CheckBox Content="АВТОМАТИЧЕСКИ ПО ВЫСОТЕ"
                    IsChecked="{Binding AutomaticDepth, Mode=TwoWay}" />
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBlock Text="Уровней вручную" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding ManualDepth, Mode=TwoWay}"
                           Minimum="8" Maximum="{Binding MaximumDepth}" Increment="1" />
          </Grid>
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBlock Text="Шаг тачпада" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding GestureStep, Mode=TwoWay}"
                           Minimum="1" Maximum="20" Increment="1" />
          </Grid>
          <TextBlock Text="{Binding DepthLabel}" Foreground="#AEB6C3" FontSize="10" />
          <Border Height="1" Background="#343A45" Margin="0,5" />
          <TextBlock Text="МАСШТАБ ОБЪЁМА" Foreground="#8B93A1" FontSize="10" />
          <CheckBox Content="АВТО · МАКСИМАЛЬНЫЙ ВИДИМЫЙ = 100%"
                    IsChecked="{Binding AutomaticVolumeScale, Mode=TwoWay}" />
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBlock Text="Опорный объём" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding ManualVolumeReference, Mode=TwoWay}"
                           Minimum="0.00000001" Maximum="1000000000000"
                           Increment="1" FormatString="0.########" />
          </Grid>
          <Border Height="1" Background="#343A45" Margin="0,5" />
          <TextBlock Text="ЦВЕТА ПОЛОС · #RRGGBB ИЛИ #AARRGGBB"
                     Foreground="#8B93A1" FontSize="10" />
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBlock Text="Продажа" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding AskColor, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBlock Text="Макс. продажа" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LargestAskColor, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBlock Text="Покупка" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding BidColor, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <TextBlock Text="Макс. покупка" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LargestBidColor, Mode=TwoWay}" />
          </Grid>
          <TextBlock Text="{Binding PaletteState}" Foreground="#F5C96A"
                     FontSize="10" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PersistenceState}" Foreground="#AEB6C3"
                     FontSize="10" TextWrapping="Wrap" />
          <Button Content="ВЕРНУТЬ МОИ ЦВЕТА" Tag="{Binding Venue}"
                  Click="ResetBookPalette_Click" Padding="8,6" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="54,*,36">
    <Border BorderBrush="#242830" BorderThickness="0,0,0,1">
      <Grid Margin="16,0" ColumnDefinitions="*,Auto,*">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding InstrumentTitle}" FontWeight="SemiBold" />
          <TextBlock Text="ТРИ БИРЖИ · КНИГИ РАЗДЕЛЕНЫ" Foreground="#8B93A1" FontSize="10" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding CrossVenueDivergence}" Foreground="{Binding CrossVenueDivergenceColor}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ConsensusVerdict}" Foreground="{Binding ConsensusColor}" FontSize="10" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding MexcConnectionStatus, StringFormat='MEXC {0}'}" />
          <TextBlock Text="{Binding GateConnectionStatus, StringFormat='GATE {0}'}" />
          <TextBlock Text="{Binding ConnectionStatus, StringFormat='BYBIT {0}'}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="OrderBookSurface" Grid.Row="1" ColumnDefinitions="190,*,*,*">
      <Border BorderBrush="#242830" BorderThickness="0,0,1,0" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="7">
          <TextBlock Text="{Binding ProductLabel, StringFormat='ПРОДУКТ · {0}'}" Foreground="#D8DDE5" FontWeight="SemiBold" FontSize="11" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button Content="SPOT" Click="SelectSpot_Click" Padding="8,7" />
            <Button Grid.Column="1" Content="FUTURES" Click="SelectFutures_Click" Padding="8,7" />
          </Grid>
          <TextBlock Text="АКТИВ" Foreground="#8B93A1" FontSize="11" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button Content="BTC / USDT" Click="SelectBtc_Click" Padding="8,7" />
            <Button Grid.Column="1" Content="APT / USDT" Click="SelectApt_Click" Padding="8,7" />
          </Grid>
          <TextBox Text="{Binding InstrumentSearchText, Mode=TwoWay}"
                   PlaceholderText="Быстрый поиск пары" />
          <TextBlock Text="{Binding CatalogState}" Foreground="#8B93A1"
                     FontSize="9" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding InstrumentSearchResults}"
                   MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding}" Tag="{Binding}"
                        Click="SelectCatalogInstrument_Click"
                        HorizontalContentAlignment="Left" Padding="6,4" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Background="#15181D" BorderBrush="#343A45" BorderThickness="1"
                  CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <StackPanel Spacing="7">
              <TextBlock Text="DRY RUN · ОРДЕР НЕ ОТПРАВЛЯЕТСЯ"
                         Foreground="#F5C96A" FontWeight="Bold" FontSize="10"
                         TextWrapping="Wrap" />
              <TextBlock Text="АКТИВНАЯ БИРЖА" Foreground="#8B93A1" FontSize="9" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button Content="MEXC" Click="SelectDryRunMexc_Click" Padding="4,5" FontSize="10" />
                <Button Grid.Column="1" Content="GATE" Click="SelectDryRunGate_Click" Padding="4,5" FontSize="10" />
                <Button Grid.Column="2" Content="BYBIT" Click="SelectDryRunBybit_Click" Padding="4,5" FontSize="10" />
              </Grid>
              <TextBlock Text="{Binding ActiveDryRunVenue, StringFormat='ВЫБРАНА · {0}'}"
                         FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                <Button Content="BUY MARKET" Click="SelectDryRunBuy_Click" Padding="4,6" />
                <Button Grid.Column="1" Content="SELL MARKET" Click="SelectDryRunSell_Click" Padding="4,6" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding DryRunValueText, Mode=TwoWay}"
                         PlaceholderText="Размер" />
                <TextBlock Grid.Column="1" Text="{Binding DryRunUnit}"
                           FontWeight="Bold" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding DryRunRoute}" Foreground="#AEB6C3"
                         FontSize="10" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DryRunPreview}" Foreground="#F5C96A"
                         FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DryRunLimitLabel}" Foreground="#AEB6C3"
                         FontSize="9" TextWrapping="Wrap" />
              <Border Background="#24171A" CornerRadius="4" Padding="7,5">
                <TextBlock Text="{Binding DryRunRiskState}" Foreground="#FF9CA6"
                           FontWeight="Bold" HorizontalAlignment="Center" />
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                <Button Content="STOP" Click="EngageDryRunStop_Click" Padding="4,6" />
                <Button Grid.Column="1" Content="SAFE · DRY RUN"
                        Click="DisengageDryRunStop_Click" Padding="4,6" FontSize="9" />
              </Grid>
              <Button Content="ПОДГОТОВИТЬ DRY RUN"
                      Click="PrepareDryRunSimulation_Click" Padding="5,7" />
              <Button Content="ПОДТВЕРДИТЬ СИМУЛЯЦИЮ"
                      Click="ConfirmDryRunSimulation_Click" Padding="5,7" />
              <Button Content="ПРОИГРАТЬ СИМУЛЯЦИЮ"
                      Click="PlayDryRunSimulation_Click" Padding="5,7" />
              <TextBlock Text="{Binding DryRunConfirmationState}" Foreground="#F5C96A"
                         FontSize="9" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SimulationTimeline}" Foreground="#AEB6C3"
                         FontSize="9" TextWrapping="Wrap" />
              <TextBlock Text="SIMULATION ONLY · TRADING ADAPTER NOT IMPLEMENTED"
                         Foreground="#656D79" FontSize="9" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="#15181D" BorderBrush="#2A2F37" BorderThickness="1"
                  CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="MEXC API" FontWeight="SemiBold" />
              <TextBlock Text="KEYCHAIN · ЗНАЧЕНИЯ СКРЫТЫ" Foreground="#656D79"
                         FontSize="9" />
              <TextBlock Text="{Binding MexcPrivateStatus}" Foreground="#8B93A1"
                         FontSize="9" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MexcOrderTestStatus}" Foreground="#8B93A1"
                         FontSize="9" TextWrapping="Wrap" />
              <Border Background="#111419" CornerRadius="4" Padding="7" Margin="0,3,0,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="READ-ONLY" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ReadOnlyCredentialStatus}" Foreground="#8B93A1" FontSize="9" />
                  <TextBox PlaceholderText="API key" PasswordChar="●" Text="{Binding ReadOnlyApiKey, Mode=TwoWay}" />
                  <TextBox PlaceholderText="Secret" PasswordChar="●" Text="{Binding ReadOnlySecret, Mode=TwoWay}" />
                  <CheckBox Content="УДАЛИТЬ СТАРУЮ ПАРУ И ЗАМЕНИТЬ · ПРИ ОШИБКЕ ОСТАНЕТСЯ НЕ НАСТРОЕНА"
                            IsChecked="{Binding ReadOnlyReplaceConfirmed, Mode=TwoWay}" />
                  <Button Content="СОХРАНИТЬ В KEYCHAIN" Click="SaveReadOnlyCredentials_Click" Padding="5,6" />
                  <Button Content="УДАЛИТЬ" IsVisible="{Binding CanRevokeReadOnlyCredential}"
                          Click="ArmReadOnlyCredentialRevoke_Click" Padding="5,6" />
                  <Button Content="ПОДТВЕРДИТЬ УДАЛЕНИЕ" IsVisible="{Binding CanConfirmRevokeReadOnlyCredential}"
                          Click="ConfirmReadOnlyCredentialRevoke_Click" Padding="5,6" />
                  <TextBlock Text="{Binding ReadOnlyCredentialAction}" Foreground="#F5C96A" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Background="#111419" CornerRadius="4" Padding="7" Margin="0,3,0,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="ORDER TEST" FontWeight="SemiBold" />
                  <TextBlock Text="ТРЕБУЕТ TRADE PERMISSION · БЕЗ WITHDRAWAL" Foreground="#F5C96A" FontSize="9" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding OrderTestCredentialStatus}" Foreground="#8B93A1" FontSize="9" />
                  <TextBox PlaceholderText="API key" PasswordChar="●" Text="{Binding OrderTestApiKey, Mode=TwoWay}" />
                  <TextBox PlaceholderText="Secret" PasswordChar="●" Text="{Binding OrderTestSecret, Mode=TwoWay}" />
                  <CheckBox Content="УДАЛИТЬ СТАРУЮ ПАРУ И ЗАМЕНИТЬ · ПРИ ОШИБКЕ ОСТАНЕТСЯ НЕ НАСТРОЕНА"
                            IsChecked="{Binding OrderTestReplaceConfirmed, Mode=TwoWay}" />
                  <Button Content="СОХРАНИТЬ В KEYCHAIN" Click="SaveOrderTestCredentials_Click" Padding="5,6" />
                  <Button Content="УДАЛИТЬ" IsVisible="{Binding CanRevokeOrderTestCredential}"
                          Click="ArmOrderTestCredentialRevoke_Click" Padding="5,6" />
                  <Button Content="ПОДТВЕРДИТЬ УДАЛЕНИЕ" IsVisible="{Binding CanConfirmRevokeOrderTestCredential}"
                          Click="ConfirmOrderTestCredentialRevoke_Click" Padding="5,6" />
                  <TextBlock Text="{Binding OrderTestCredentialAction}" Foreground="#F5C96A" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Stable venue order: MEXC, Gate, Bybit. Each card owns its own book. -->
      <Border Grid.Column="1" BorderBrush="#242830" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="42,*,38,*" Tag="Mexc"
              SizeChanged="BookViewport_SizeChanged"
              PointerWheelChanged="BookViewport_PointerWheelChanged">
          <Grid Margin="10,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding MexcCardTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding MexcConnectionStatus}" Foreground="#8B93A1" FontSize="10" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Row="1">
            <TextBlock Text="{Binding MexcEmptyState}" Foreground="#656D79" FontSize="11" TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding MexcAsks}" ItemTemplate="{StaticResource AskRow}"
                          VerticalAlignment="Bottom" ClipToBounds="True" Margin="0,0,0,4" />
          </Grid>
          <Border Grid.Row="2" Background="#171A20" BorderBrush="#242830" BorderThickness="0,1">
            <Grid Margin="10,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding MexcSpread, StringFormat='Спред {0}'}" Foreground="#8B93A1" />
                <TextBlock Text="{Binding MexcBookSettings.DepthLabel}" Foreground="#656D79" FontSize="9" />
              </StackPanel>
              <Button Grid.Column="1" Content="⚙" Padding="7,2" ToolTip.Tip="Настройки MEXC"
                      Click="OpenBookSettings_Click">
                <Button.Flyout><Flyout Placement="Top"><ContentControl Content="{Binding MexcBookSettings}" ContentTemplate="{StaticResource BookSettingsPanel}" /></Flyout></Button.Flyout>
              </Button>
              <TextBlock Grid.Column="2" Text="{Binding MexcLastPrice}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="3" ItemsSource="{Binding MexcBids}" ItemTemplate="{StaticResource BidRow}"
                        ClipToBounds="True" Margin="0,4,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="2" BorderBrush="#242830" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="42,*,38,*" Tag="Gate"
              SizeChanged="BookViewport_SizeChanged"
              PointerWheelChanged="BookViewport_PointerWheelChanged">
          <Grid Margin="10,0" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding GateCardTitle}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding GateConnectionStatus}" Foreground="#8B93A1" FontSize="10" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="1"><TextBlock Text="{Binding GateEmptyState}" Foreground="#656D79" FontSize="11" TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" /><ItemsControl ItemsSource="{Binding GateAsks}" ItemTemplate="{StaticResource AskRow}" VerticalAlignment="Bottom" ClipToBounds="True" Margin="0,0,0,4" /></Grid>
          <Border Grid.Row="2" Background="#171A20" BorderBrush="#242830" BorderThickness="0,1">
            <Grid Margin="10,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding GateSpread, StringFormat='Спред {0}'}" Foreground="#8B93A1" />
                <TextBlock Text="{Binding GateBookSettings.DepthLabel}" Foreground="#656D79" FontSize="9" />
              </StackPanel>
              <Button Grid.Column="1" Content="⚙" Padding="7,2" ToolTip.Tip="Настройки Gate"
                      Click="OpenBookSettings_Click">
                <Button.Flyout><Flyout Placement="Top"><ContentControl Content="{Binding GateBookSettings}" ContentTemplate="{StaticResource BookSettingsPanel}" /></Flyout></Button.Flyout>
              </Button>
              <TextBlock Grid.Column="2" Text="{Binding GateLastPrice}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="3" ItemsSource="{Binding GateBids}" ItemTemplate="{StaticResource BidRow}" ClipToBounds="True" Margin="0,4,0,0" />
        </Grid>
      </Border>

      <Border Grid.Column="3">
        <Grid RowDefinitions="42,*,38,*" Tag="Bybit"
              SizeChanged="BookViewport_SizeChanged"
              PointerWheelChanged="BookViewport_PointerWheelChanged">
          <Grid Margin="10,0" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding BybitCardTitle}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" Foreground="#8B93A1" FontSize="10" VerticalAlignment="Center" /></Grid>
          <Grid Grid.Row="1"><TextBlock Text="{Binding BybitEmptyState}" Foreground="#656D79" FontSize="11" TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" /><ItemsControl ItemsSource="{Binding Asks}" ItemTemplate="{StaticResource AskRow}" VerticalAlignment="Bottom" ClipToBounds="True" Margin="0,0,0,4" /></Grid>
          <Border Grid.Row="2" Background="#171A20" BorderBrush="#242830" BorderThickness="0,1">
            <Grid Margin="10,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Spread, StringFormat='Спред {0}'}" Foreground="#8B93A1" />
                <TextBlock Text="{Binding BybitBookSettings.DepthLabel}" Foreground="#656D79" FontSize="9" />
              </StackPanel>
              <Button Grid.Column="1" Content="⚙" Padding="7,2" ToolTip.Tip="Настройки Bybit"
                      Click="OpenBookSettings_Click">
                <Button.Flyout><Flyout Placement="Top"><ContentControl Content="{Binding BybitBookSettings}" ContentTemplate="{StaticResource BookSettingsPanel}" /></Flyout></Button.Flyout>
              </Button>
              <TextBlock Grid.Column="2" Text="{Binding LastPrice}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl Grid.Row="3" ItemsSource="{Binding Bids}" ItemTemplate="{StaticResource BidRow}" ClipToBounds="True" Margin="0,4,0,0" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" BorderBrush="#242830" BorderThickness="0,1,0,0">
      <Grid Margin="16,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding SharedScaleLabel}" Foreground="#8B93A1" FontSize="11" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding RuntimeSafetyStatus}" Foreground="#FFD60A" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
